{
  "name": "react-native-turbo-sqlite-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "i": "yarn install && cd ios && pod install && cd ..",
    "android": "npx react-native run-android",
    "ios": "npx react-native run-ios",
    "macos": "REACT_NATIVE_PLATFORM=macos react-native run-macos",
    "start": "npx react-native start",
    "start:macos": "REACT_NATIVE_PLATFORM=macos react-native start",
    "web:metro": "npx react-native start --config metro.web.config.js --port 8081",
    "web": "vite",
    "web:webpack": "webpack serve --config webpack.config.js --mode development --port 8082",
    "web:webpack:build": "webpack --config webpack.config.js --mode production",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "build:android": "cd android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "cd ios && xcodebuild -workspace TurboSqliteExample.xcworkspace -scheme TurboSqliteExample -configuration Debug -sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO",
    "build:macos": "cd macos && xcodebuild -workspace TurboSqliteExample.xcworkspace -scheme TurboSqliteExample-macOS -configuration Release -sdk macosx CODE_SIGNING_ALLOWED=NO COMPILER_INDEX_STORE_ENABLE=NO",
    "clean": "yarn clean:ios; yarn clean:android; yarn clean:node; yarn clean:cache",
    "clean:ios": "cd ios && rm -rf build Pods Podfile.lock && xcodebuild -workspace TurboSqliteExample.xcworkspace -scheme TurboSqliteExample clean 2>/dev/null || true",
    "clean:android": "cd android && ./gradlew clean && rm -rf .gradle .cxx app/build build || true",
    "clean:node": "rm -rf node_modules || true",
    "clean:cache": "watchman watch-del-all 2>/dev/null || true && rm -rf ${TMPDIR}metro-*",
    "generate-protos": "@bufbuild/buf generate",
    "test:e2e:ios:build": "detox build --configuration ios.sim.debug",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "codegen:windows": "npx @react-native-community/cli codegen-windows",
    "windows": "npx @react-native-community/cli run-windows"
  },
  "dependencies": {
    "@bufbuild/buf": "^1.39.0",
    "@bufbuild/protobuf": "^2.0.0",
    "@bufbuild/protoc-gen-es": "^2.0.0",
    "fast-text-encoding": "^1.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-macos": "npm:react@19.2.0",
    "react-native": "0.84.1",
    "react-native-macos": "0.83.0",
    "react-native-turbo-sqlite": "*",
    "react-native-web": "^0.21.2",
    "react-native-windows": "0.84.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@rnx-kit/jest-preset": "^0.1.17",
    "@types/detox": "^18.1.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-loader": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "detox": "^20.44.0",
    "html-webpack-plugin": "^5.6.4",
    "jest": "^30.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.2",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "engines": {
    "node": ">= 22.12.0"
  },
  "react-native-turbo-sqlite": {
    "sqlcipher": true
  },
  "codegenConfig": {
    "name": "TurboSqliteExampleSpec",
    "type": "modules",
    "jsSrcsDir": "src/turbomodules",
    "android": {
      "javaPackageName": "com.turbosqliteexample.specs"
    },
    "windows": {
      "namespace": "ReactNativeTurboSqliteExampleCodegen",
      "outputDirectory": "windows/ReactNativeTurboSqliteExample/codegen",
      "separateDataTypes": true
    }
  },
  "react-native-windows": {
    "init-windows": {
      "name": "ReactNativeTurboSqliteExample",
      "namespace": "ReactNativeTurboSqliteExample",
      "template": "cpp-app"
    }
  }
}
